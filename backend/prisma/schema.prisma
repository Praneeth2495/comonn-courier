// ============================================================
// Comonn International Courier — Database Schema
// ============================================================
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Atomic per-month sequence counters for human-friendly order/tracking
// numbers (DDMM0<seq>, seq resets each calendar month). Keyed by
// "<kind>-<year>-<month>" e.g. "order-2026-07". A plain count()-then-+1
// races under concurrent order creation; this table's row is updated
// with a single atomic UPDATE per request instead.
model SequenceCounter {
  key   String @id
  value Int    @default(0)
}

// ------------------------------------------------------------
// Auth / Users
// ------------------------------------------------------------
enum Role {
  CUSTOMER
  ADMIN
  STAFF
  DRIVER
}

model User {
  id                      String    @id @default(uuid())
  email                   String    @unique
  passwordHash            String
  fullName                String
  phone                   String?
  company                 String?
  role                    Role      @default(CUSTOMER)
  isActive                Boolean   @default(true)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  // Null for a guest-checkout account auto-created with an unusable random
  // password (see accountProvisioning.js) until the customer actually
  // chooses one; set immediately for self-registered accounts. Drives the
  // 1-hour account-setup follow-up email (see accountSetupFollowup.js).
  passwordSetAt           DateTime?
  accountSetupEmailSentAt DateTime?
  // Free-text home-region label for a DRIVER account only (e.g. "HYD") —
  // shown alongside their name in the "send to driver" picker so staff can
  // tell two same-named drivers apart. Meaningless for any other role.
  driverRegion            String?
  // STAFF-only opt-in, granted individually by ADMIN via the Users panel,
  // to see the "Staff overview" / "Region overview" tabs on their own
  // Overview page — a broader, cross-region view than their own
  // region-scoped stats (see StaffRegionAssignment). Meaningless for ADMIN,
  // who already sees everything regardless of this flag.
  canViewOverviewBreakdown Boolean @default(false)

  addresses               Address[]
  orders                  Order[]
  auditLogs               AuditLog[]
  zoneAssignments         StaffZoneAssignment[]
  regionAssignments       StaffRegionAssignment[]
  passwordSetTokens       PasswordSetToken[]
  orderComments           OrderComment[]
  driverJobs              Order[]                  @relation("OrderDriver")
  inventoryUpdates        InventoryItem[]
  scanBatches             ScanBatch[]
  scanLocations           ScanLocation[]
  createdMerchants        Merchant[]
  merchantInvoiceComments MerchantInvoiceComment[]
  partyInvoicesCreated    PartyInvoice[]
  partyInvoiceComments    PartyInvoiceComment[]
  customsClientsCreated   CustomsClient[]
  boxBookings             BoxBooking[]
  boxBookingComments      BoxBookingComment[]
  manifestsCreated        Manifest[]

  @@index([email])
}

// Internal admin/staff notes on an order. Deliberately separate from
// TrackingEvent, whose `note` field is exposed on the public,
// unauthenticated /api/track endpoint — an internal comment must never
// leak there.
model OrderComment {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([orderId])
}

// A trusted e-commerce/API partner — manually onboarded, no self-serve
// signup. Books shipments via POST /v1/shipments (see merchantAuth.js),
// billed on postpaid credit rather than per-shipment checkout: shipments
// are created already PAID, then rolled up into a MerchantInvoice once a
// day (see merchantInvoiceGenerator.js).
model Merchant {
  id           String            @id @default(uuid())
  name         String
  contactEmail String
  contactPhone String?
  // Only the hash is ever stored — the raw key is shown once at creation
  // time and cannot be retrieved again. apiKeyPrefix lets staff identify a
  // key in the admin UI without re-revealing the secret.
  apiKeyHash   String            @unique
  apiKeyPrefix String
  isActive     Boolean           @default(true)
  createdById  String
  createdBy    User              @relation(fields: [createdById], references: [id])
  orders       Order[]
  invoices     MerchantInvoice[]
  createdAt    DateTime          @default(now())
}

// One consolidated invoice per merchant per calendar day (IST), covering
// every shipment they booked that day. "Overdue" (due INVOICE_DUE_DAYS —
// see merchantInvoiceGenerator.js — after invoiceDate) is computed from
// invoiceDate at read time, not stored. Once overdue, new shipments are
// blocked (see findOverdueInvoice in merchantApi.controller.js) until paid.
model MerchantInvoice {
  id             String                   @id @default(uuid())
  merchantId     String
  merchant       Merchant                 @relation(fields: [merchantId], references: [id])
  invoiceDate    DateTime
  totalAmount    Decimal                  @db.Decimal(10, 2)
  currency       String                   @default("INR")
  status         String                   @default("UNPAID") // UNPAID | PAID
  paymentMethod  String? // 'razorpay_link' | 'bank_transfer'
  paymentLinkUrl String?
  // Razorpay's payment_link id — matched against the payment_link.paid
  // webhook event to auto-mark this PAID (see payment.controller.js).
  paymentLinkId  String?
  paidAt         DateTime?
  orders         Order[]
  comments       MerchantInvoiceComment[]
  createdAt      DateTime                 @default(now())

  @@unique([merchantId, invoiceDate])
  @@index([merchantId])
}

// Same shape/purpose as OrderComment, for merchant invoices — manual
// status changes (e.g. "marked paid via bank transfer") auto-create one
// of these, same pattern as updateOrderStatus does for orders.
model MerchantInvoiceComment {
  id        String          @id @default(uuid())
  invoiceId String
  invoice   MerchantInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  authorId  String
  author    User            @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime        @default(now())

  @@index([invoiceId])
}

// ------------------------------------------------------------
// Receivable / Payable invoicing (independent of Order billing and the
// merchant-billing system above) — freeform invoices the business raises
// against a payer (RECEIVABLE, money owed to the business) or that a
// vendor raises against the business (PAYABLE, money the business owes).
// Both directions share this one model since their fields/behaviour are
// identical; only the label, invoice-number prefix (RIN/PIN — see
// generatePartyInvoiceNumber in utils/invoiceNumber.js) and list filter
// differ. "Overdue" is computed at read time from dueDate, same as
// MerchantInvoice, not stored.
enum InvoiceDirection {
  RECEIVABLE
  PAYABLE
}

enum RecurrenceInterval {
  NONE
  WEEKLY
  MONTHLY
  YEARLY
}

model PartyInvoice {
  id               String                @id @default(uuid())
  direction        InvoiceDirection
  invoiceNumber    String                @unique
  partyName        String
  businessName     String?
  description      String
  amount           Decimal               @db.Decimal(10, 2)
  gstPercent       Decimal               @default(0) @db.Decimal(5, 2)
  totalAmount      Decimal               @db.Decimal(10, 2)
  currency         String                @default("INR")
  dueDate          DateTime
  email            String?
  phone            String?
  status           String                @default("UNPAID") // UNPAID | PAID
  paidAt           DateTime?
  recurrence       RecurrenceInterval    @default(NONE)
  // Only set (and only meaningful) on the root invoice of a recurring
  // series — the background job (partyInvoiceRecurrence.js) scans for rows
  // where this is due, clones a new child invoice, then advances it.
  // Cloned children always get recurrence=NONE so only the root drives
  // the schedule.
  nextRecurrenceAt DateTime?
  parentInvoiceId  String?
  parentInvoice    PartyInvoice?         @relation("InvoiceRecurrence", fields: [parentInvoiceId], references: [id])
  childInvoices    PartyInvoice[]        @relation("InvoiceRecurrence")
  // Staff-uploaded source document (e.g. a vendor's own bill for a
  // Payable). Stored as bytes in the DB rather than local disk — unlike
  // the generated PDF below, this isn't derivable from other DB fields,
  // so it would be permanently lost on a Railway redeploy if left on disk.
  attachmentName   String?
  attachmentMime   String?
  attachmentData   Bytes?
  // The system-generated PDF (see partyInvoicePdf.js) — safe to keep on
  // local disk and regenerate on the fly if missing, same pattern as
  // Invoice/Label.
  pdfFileUrl       String?
  createdById      String
  createdBy        User                  @relation(fields: [createdById], references: [id])
  comments         PartyInvoiceComment[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([direction])
  @@index([status])
  @@index([nextRecurrenceAt])
}

// Same shape/purpose as OrderComment/MerchantInvoiceComment.
model PartyInvoiceComment {
  id        String       @id @default(uuid())
  invoiceId String
  invoice   PartyInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  authorId  String
  author    User         @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime     @default(now())

  @@index([invoiceId])
}

// A standalone contact directory for customs-clearance clients — no
// linkage to Order/shipments requested, just a searchable list.
model CustomsClient {
  id           String   @id @default(uuid())
  name         String
  businessName String?
  mobile       String
  email        String?
  countryCode  String
  city         String
  address      String
  createdById  String
  createdBy    User     @relation(fields: [createdById], references: [id])
  createdAt    DateTime @default(now())

  @@index([countryCode])
}

// ------------------------------------------------------------
// Box Storage — customers rent a numbered physical box at the office
// (3 sizes, day-based pricing) and get shown "<office address>, Box <N>"
// to give to e-commerce sellers. Payment is deliberately kept on its own
// BoxPayment model rather than reusing Payment/Order — the existing
// webhook/markOrdersPaidForProviderOrder path is hard-coded to Order, and
// this avoids touching that financially-critical flow at all.
model BoxSize {
  id          String       @id @default(uuid())
  code        String       @unique // "SMALL" | "MEDIUM" | "LARGE"
  name        String
  description String?
  monthlyRate Decimal      @db.Decimal(10, 2)
  currency    String       @default("INR")
  isActive    Boolean      @default(true)
  boxes       Box[]
  bookings    BoxBooking[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Box {
  id        String       @id @default(uuid())
  boxSizeId String
  boxSize   BoxSize      @relation(fields: [boxSizeId], references: [id])
  number    Int // shown to customers as "Box 23"
  status    String       @default("AVAILABLE") // AVAILABLE | RENTED | RETIRED
  retiredAt DateTime?
  bookings  BoxBooking[]
  createdAt DateTime     @default(now())

  @@unique([boxSizeId, number])
  @@index([status])
}

// PENDING = checkout started, no box assigned yet (assignment happens
// atomically at payment confirmation — see markBoxBookingPaid in
// boxBooking.controller.js — so an abandoned checkout never holds a
// physical box hostage). ACTIVE = paid + box assigned. EXPIRED = past
// endDate, box already returned to the pool. CANCELLED = payment never
// completed, or the rare box-unavailable race was auto-refunded.
model BoxBooking {
  id                   String    @id @default(uuid())
  boxSizeId            String
  boxSize              BoxSize   @relation(fields: [boxSizeId], references: [id])
  boxId                String?
  box                  Box?      @relation(fields: [boxId], references: [id])
  customerId           String
  customer             User      @relation(fields: [customerId], references: [id])
  days                 Int
  monthlyRate          Decimal   @db.Decimal(10, 2) // snapshot at booking time
  totalAmount          Decimal   @db.Decimal(10, 2)
  currency             String    @default("INR")
  status               String    @default("PENDING") // PENDING | ACTIVE | EXPIRED | CANCELLED
  startDate            DateTime?
  endDate              DateTime?
  // Set once, the first time the booking is confirmed paid (never on
  // renewal — one invoice number covers the booking's whole lifetime,
  // same "RIN"/"PIN" numbering idiom as PartyInvoice.
  invoiceNumber        String?   @unique
  pdfFileUrl           String?
  // Set once the "expiring soon" email has gone out (to both the customer
  // and every admin/staff user) — cleared on renewal so the reminder
  // cycle restarts against the new endDate. Same dedup idiom as
  // User.accountSetupEmailSentAt.
  expiryReminderSentAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  payments BoxPayment[]
  comments BoxBookingComment[]

  @@index([customerId])
  @@index([status])
  @@index([endDate])
}

// Same shape/purpose as OrderComment/PartyInvoiceComment — internal
// admin/staff notes. Manual status changes (via updateBookingStatus) also
// auto-create one of these, same pattern as updateOrderStatus does.
model BoxBookingComment {
  id        String     @id @default(uuid())
  bookingId String
  booking   BoxBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  authorId  String
  author    User       @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime   @default(now())

  @@index([bookingId])
}

// One row per checkout attempt against a booking — the initial payment
// AND every later renewal each get their own row (not a 1:1 with
// BoxBooking), so the webhook can reconcile a renewal exactly like the
// initial payment instead of needing a separate, less-safe code path.
// `days` is carried on the payment itself (not just the booking) so
// markBoxBookingPaid knows how many days a given payment is for,
// regardless of whether it's the first payment or a renewal.
model BoxPayment {
  id                String     @id @default(uuid())
  boxBookingId      String
  boxBooking        BoxBooking @relation(fields: [boxBookingId], references: [id])
  days              Int
  providerOrderId   String     @unique // Razorpay order id
  providerPaymentId String?
  amount            Decimal    @db.Decimal(10, 2)
  currency          String     @default("INR")
  status            String     @default("REQUIRES_PAYMENT") // REQUIRES_PAYMENT | SUCCEEDED | FAILED | REFUNDED
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([boxBookingId])
}

// Issued when an account is auto-created for a guest checkout (or when a
// customer requests "Forgot password"). The raw token is emailed to the
// customer and only its hash is stored, same pattern as the OTP flow.
model PasswordSetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Address {
  id           String   @id @default(uuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label        String? // "Home", "Warehouse", etc.
  contactName  String
  phone        String
  email        String?
  instructions String? // pickup instructions (sender) or delivery instructions (receiver)
  line1        String
  line2        String?
  city         String
  state        String?
  postcode     String
  countryCode  String // ISO 3166-1 alpha-2, e.g. "AU"
  isDefault    Boolean  @default(false)
  isSaved      Boolean  @default(false) // true = user's address book entry; false = a per-order snapshot
  createdAt    DateTime @default(now())

  ordersAsSender   Order[] @relation("SenderAddress")
  ordersAsReceiver Order[] @relation("ReceiverAddress")
}

// ------------------------------------------------------------
// Pricing: Zones, Countries, Rate Cards
// ------------------------------------------------------------
// A Zone groups destination countries that share the same rate table
// (typical for international courier pricing: Zone A = neighbouring
// region, Zone B = wider region, Zone C = rest of world, etc).
model Zone {
  id               String                @id @default(uuid())
  code             String                @unique // "ZONE_A"
  name             String // "Zone A — Asia Pacific"
  // "destination" = customer-facing shipping zone, matched via CountryZone
  // and used as RateCard.zoneId. "origin" = domestic India pickup-postcode
  // classification (e.g. "India-urban"), matched via PostcodeZone and used
  // as RateCard.fromZoneId — kept distinct so the admin's destination-zone
  // dropdown never gets polluted with origin-only zones.
  kind             String                @default("destination")
  countries        CountryZone[]
  postcodeZones    PostcodeZone[]
  rateCards        RateCard[]            @relation("RateCardZone")
  rateCardsFrom    RateCard[]            @relation("RateCardFromZone")
  staffAssignments StaffZoneAssignment[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
}

// Maps a domestic India pickup postcode to an origin Zone (kind="origin"),
// so pricing can optionally differ by pickup location via
// RateCard.fromZoneId — imported from the same source as
// PostcodeSuggestion. A postcode not found here has no origin-zone
// restriction (matches any RateCard, i.e. treated as the baseline/default).
model PostcodeZone {
  id          String @id @default(uuid())
  countryCode String // ISO alpha-2, e.g. "IN"
  postcode    String
  zoneId      String
  zone        Zone   @relation(fields: [zoneId], references: [id])

  @@unique([countryCode, postcode])
}

// Admin-controlled: which STAFF accounts can see/filter Delivery orders in
// which (destination) zones. A staff member with no rows here sees no
// orders (opt-in, so admin explicitly divides zones among staff rather than
// everyone seeing everything by default). Pickup orders are scoped by
// origin state/region instead — see StaffRegionAssignment.
model StaffZoneAssignment {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  zoneId    String
  zone      Zone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, zoneId])
}

// Admin-controlled: which STAFF accounts can see/filter Pickup orders from
// which origin (sender) state/region — pickups are about where a parcel is
// collected from, not the destination zone, so they're scoped separately
// from StaffZoneAssignment. region=null means "the whole state" (every
// region within it); a non-null region narrows to just that one. Same
// opt-in model as zone assignment: no rows here = no pickup orders visible.
model StaffRegionAssignment {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  state     String
  region    String?
  createdAt DateTime @default(now())

  @@unique([userId, state, region])
}

model CountryZone {
  id          String @id @default(uuid())
  countryCode String @unique // ISO alpha-2
  countryName String
  zoneId      String
  zone        Zone   @relation(fields: [zoneId], references: [id])
}

// Postcode -> suburb/state autocomplete for the sender/receiver address
// forms (India only for now — imported from an Australia-Post-style
// suggestion list). One postcode maps to many suburbs, so lookups return a
// list for the customer to pick from rather than a single match.
model PostcodeSuggestion {
  id          String  @id @default(uuid())
  countryCode String // ISO alpha-2, e.g. "IN"
  postcode    String
  suburb      String
  state       String?
  // Optional human-facing sub-area name for this postcode/suburb (e.g.
  // "Hyderabad", "Vijayawada") — independent of pricing. Powers the admin
  // Pickup-orders panel's origin state/region filters; null where the
  // source data doesn't assign one (currently only populated for India).
  region      String?
  // Destination airport code for this postcode (e.g. "MEL") — powers
  // Order.airportCode resolution, which drives the Manifest tab's
  // sub-region grouping. Currently populated for AU/NZ/CA/GB/US/IN.
  airport     String?

  @@index([countryCode, postcode])
  @@index([countryCode, region])
}

// A Service is a product line: Express, Economy, Freight, Documents...
model Service {
  id                String     @id @default(uuid())
  code              String     @unique // "EXPRESS"
  name              String // "Express Worldwide"
  description       String?
  transitDaysMin    Int
  transitDaysMax    Int
  volumetricDivisor Int        @default(5000) // cm3 per kg, industry-standard default
  isActive          Boolean    @default(true)
  rateCards         RateCard[]
  orders            Order[]
}

// RateCard = one weight-break price for a given service + destination zone,
// optionally narrowed further by an origin (pickup) zone.
// e.g. Service=EXPRESS, Zone=ZONE_A, 0-0.5kg => $18.50 base,
// then perKgAbove for weight beyond the bracket ceiling.
model RateCard {
  id             String    @id @default(uuid())
  serviceId      String
  service        Service   @relation(fields: [serviceId], references: [id])
  zoneId         String
  zone           Zone      @relation("RateCardZone", fields: [zoneId], references: [id])
  // Optional origin (pickup) zone — e.g. a bracket that only applies when
  // picking up from an "India-rural" postcode. NULL matches any origin, so
  // every existing rate card (with no origin dimension) keeps working
  // unchanged; a bracket with a specific fromZoneId is preferred over a
  // NULL one when both match (see pricingEngine.js's findRateBracket).
  fromZoneId     String?
  fromZone       Zone?     @relation("RateCardFromZone", fields: [fromZoneId], references: [id])
  weightFromKg   Decimal   @db.Decimal(10, 3) // inclusive lower bound
  weightToKg     Decimal   @db.Decimal(10, 3) // inclusive upper bound
  basePrice      Decimal   @db.Decimal(10, 2) // INR
  perKgOverage   Decimal   @db.Decimal(10, 2) // price per kg once weight exceeds weightToKg of the last bracket
  currency       String    @default("INR")
  // Optional per-bracket delivery timeframe override — falls back to the
  // Service's own transitDaysMin/Max (see pricingEngine.js) when unset, so
  // existing rate cards keep working unchanged.
  transitDaysMin Int?
  transitDaysMax Int?
  effectiveFrom  DateTime  @default(now())
  effectiveTo    DateTime?
  isActive       Boolean   @default(true)

  @@index([serviceId, zoneId, weightFromKg, weightToKg])
  @@index([fromZoneId])
}

// Optional extra fees layered on top of the base rate card lookup
model Surcharge {
  id                 String  @id @default(uuid())
  code               String  @unique // "FUEL", "REMOTE_AREA", "OVERSIZE"
  name               String
  type               String // "PERCENT" | "FLAT"
  value              Decimal @db.Decimal(10, 4)
  appliesToServiceId String?
  isActive           Boolean @default(true)
}

// ------------------------------------------------------------
// Orders / Shipments
// ------------------------------------------------------------
// Not a database enum — status is free text so a barcode location's label
// can become a genuine new order status (e.g. "Sorted at hub"), not just
// one of the fixed lifecycle values below. Those fixed values remain the
// ones the rest of the app's business logic (payment flow, driver actions,
// admin tab groupings, cancellation rules) checks for by exact string:
// DRAFT, PENDING_PAYMENT, PICKUP_CONFIRMED, PAID, LABEL_GENERATED,
// PICKED_UP, IN_TRANSIT, OUT_FOR_DELIVERY, DELIVERED, CANCELLED, EXCEPTION.

model Order {
  id          String  @id @default(uuid())
  orderNumber String  @unique // human-friendly e.g. CMN-2026-000123
  userId      String?
  user        User?   @relation(fields: [userId], references: [id])

  // Set when this order was booked through the merchant API (POST
  // /v1/shipments) instead of the consumer checkout flow — see
  // merchantAuth.js. merchantInvoiceId is filled in once the daily
  // consolidated-invoice job (merchantInvoiceGenerator.js) picks it up.
  merchantId        String?
  merchant          Merchant?        @relation(fields: [merchantId], references: [id])
  merchantInvoiceId String?
  merchantInvoice   MerchantInvoice? @relation(fields: [merchantInvoiceId], references: [id])

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])

  senderAddressId   String
  senderAddress     Address @relation("SenderAddress", fields: [senderAddressId], references: [id])
  receiverAddressId String
  receiverAddress   Address @relation("ReceiverAddress", fields: [receiverAddressId], references: [id])

  // parcel physical details — totals across all OrderItem lines (a shipment
  // can have multiple items; per-item dims/weight live on OrderItem)
  actualWeightKg      Decimal     @db.Decimal(10, 3)
  volumetricWeightKg  Decimal     @db.Decimal(10, 3)
  chargeableWeightKg  Decimal     @db.Decimal(10, 3) // sum of each item's max(actual, volumetric) * quantity
  declaredValue       Decimal     @default(0) @db.Decimal(10, 2)
  contentsDescription String?
  items               OrderItem[]

  // pricing snapshot (never recompute historical orders off live rate cards)
  zoneCode         String
  // Destination airport this order routes through, resolved from the
  // receiver postcode at booking time (same snapshot convention as
  // zoneCode) — see pricingEngine.resolveAirportForDestination. Null when
  // no airport data exists yet for that postcode/country; such orders
  // can't be added to a Manifest until backfilled.
  airportCode      String?
  baseFreight      Decimal @db.Decimal(10, 2)
  surchargesTotal  Decimal @default(0) @db.Decimal(10, 2)
  addonsTotal      Decimal @default(0) @db.Decimal(10, 2)
  discountTotal    Decimal @default(0) @db.Decimal(10, 2)
  taxRate          Decimal @default(0) @db.Decimal(6, 4)
  taxTotal         Decimal @default(0) @db.Decimal(10, 2)
  grandTotal       Decimal @db.Decimal(10, 2)
  currency         String  @default("INR")
  pricingBreakdown Json? // full itemised breakdown for transparency/audit

  addons    OrderAddon[]
  promoCode String?

  // "Not sure, book pickup": weight/dimensions unknown at booking time, so
  // no price is computed — courier assesses and collects cash at pickup.
  // No label/invoice is generated for these; a booking-confirmation email
  // goes to the sender instead (confirmationEmailSentAt guards against
  // re-sending it on page reload, since these orders never get a Label row).
  pricingPending          Boolean   @default(false)
  confirmationEmailSentAt DateTime?

  // pre-payment gates (Payment page)
  dgAcknowledged Boolean   @default(false) // dangerous-goods declaration
  pickupDate     String?
  // Customer's choice, asked alongside pickup date/email verification: Yes
  // gets every status-change WhatsApp update (see orderNotifications.js),
  // No still gets exactly one order-confirmation message with a Track
  // order link, just none of the follow-up status updates after that.
  whatsappOptIn  Boolean   @default(true)
  otpEmail       String?
  otpCode        String? // never returned to the client
  otpExpiresAt   DateTime?
  otpVerifiedAt  DateTime?

  status         String  @default("DRAFT")
  trackingNumber String? @unique
  invoiceNumber  String? @unique // "IN1", "IN2"... assigned at booking time, resets only on calendar year change

  // Set only when staff/admin flip status to PAID by hand from the order
  // detail dropdown (updateOrderStatus) — e.g. cash collected at pickup —
  // as opposed to the online Razorpay flow (markOrderPaid /
  // markOrdersPaidForProviderOrder in payment.controller.js), which never
  // touches this field. Lets the Accounts table flag these rows for a
  // manual-reconciliation double-check.
  manualPaymentMarkedAt DateTime?

  // Physical pickup dispatch: staff/admin send a pickup job directly to a
  // driver account, who then sees it in their own portal and marks it
  // PICKED_UP once collected in person.
  assignedDriverId String?
  assignedDriver   User?     @relation("OrderDriver", fields: [assignedDriverId], references: [id])
  driverAssignedAt DateTime?
  driverArrivedAt  DateTime? // driver marked "Arrived for pickup"
  pickedUpAt       DateTime? // driver marked "Pickup completed" (distinct from updatedAt, which later status changes would otherwise shift)

  payment        Payment?
  labels         Label[]
  invoice        Invoice?
  trackingEvents TrackingEvent[]
  comments       OrderComment[]

  // Air-freight manifest this order has been bagged into for a hub->airport
  // shipment — null until staff explicitly add it via the Manifest tab. An
  // order belongs to at most one manifest at a time.
  manifestId String?
  manifest   Manifest? @relation(fields: [manifestId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([userId])
  @@index([assignedDriverId])
  @@index([merchantId])
  @@index([merchantInvoiceId])
  @@index([manifestId])
  @@index([airportCode])
}

// A named, staff-managed grouping of destination Zones that all route
// through the same airport gateway (e.g. "Australia 1" + "Australia 2" ->
// "Mel Airport") — the sub-region filter on the Manifest tab, and also
// supplies the default "to" address when creating a manifest for it.
// One row per destination airport gateway, keyed by its airport code (e.g.
// "MEL") — matches Order.airportCode, which is resolved per-order from the
// receiver's postcode (see pricingEngine.resolveAirportForDestination), not
// per pricing Zone: a single Zone like "Australia 2" can genuinely span
// several airports (MEL/PER/SYD), so grouping at the Zone level would be
// wrong. Auto-created on first use (manifest.controller.js) with a
// placeholder name/address; admin can rename and fix the real cargo
// address afterward from the Manifest tab's "Hubs & sub-regions" setup.
model ManifestRegion {
  id             String     @id @default(uuid())
  code           String     @unique // airport code, e.g. "MEL"
  name           String // "Melbourne Airport"
  countryCode    String // ISO alpha-2, for grouping the country filter chips
  airportAddress String
  isActive       Boolean    @default(true)
  manifests      Manifest[]
  createdAt      DateTime   @default(now())

  @@index([countryCode])
}

// A saved origin warehouse/hub address — the "from" side of a manifest.
// Kept as its own small managed list (not hardcoded) since a business with
// multiple hubs needs to pick the right one per manifest.
model Hub {
  id        String     @id @default(uuid())
  name      String
  address   String
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  manifests Manifest[]
}

// One physical bag/consignment of orders shipped together from a Hub to an
// airport gateway. orderCount/totalQty/totalWeightKg are snapshotted at
// creation and recomputed on every add/remove-order edit (not derived live
// on every read) so the generated PDF sheet and these numbers always agree.
model Manifest {
  id             String          @id @default(uuid())
  manifestNumber String          @unique // "MAN1", "MAN2"... yearly-resetting
  barcodeValue   String          @unique // scannable in Batch Scan — same value as manifestNumber today, kept separate in case that ever needs to differ
  hubId          String
  hub            Hub             @relation(fields: [hubId], references: [id])
  // Destination country every order in this manifest shares — always set,
  // even when the orders span several airports within that country (see
  // regionId below), since it's what scopes "add more orders" to the right
  // pool. Derived server-side from the selected orders, not client input.
  countryCode    String
  // Only set when every order currently in the manifest resolves to the
  // exact same destination airport — a convenience link to that airport's
  // saved name/address, established once at creation and not recomputed
  // afterward. A manifest deliberately mixing several airports in the same
  // country (see order.controller.js/manifest.controller.js) simply has no
  // single region to point at; toAddress (freely editable) covers that case.
  regionId       String?
  region         ManifestRegion? @relation(fields: [regionId], references: [id])
  toAddress      String // snapshot of the airport address used, editable independent of the region's saved default
  manifestDate   DateTime
  orderCount     Int             @default(0)
  totalQty       Int             @default(0)
  totalWeightKg  Decimal         @default(0) @db.Decimal(10, 3)
  pdfFileUrl     String?
  createdById    String
  createdBy      User            @relation(fields: [createdById], references: [id])
  orders         Order[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([regionId])
  @@index([countryCode])
}

// One physical package within a (possibly multi-item) shipment.
model OrderItem {
  id                 String   @id @default(uuid())
  orderId            String
  order              Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemType           String // "Box" | "Pallet"
  actualWeightKg     Decimal  @db.Decimal(10, 3) // per single unit
  lengthCm           Decimal  @db.Decimal(10, 2)
  widthCm            Decimal  @db.Decimal(10, 2)
  heightCm           Decimal  @db.Decimal(10, 2)
  quantity           Int      @default(1)
  volumetricWeightKg Decimal  @db.Decimal(10, 3) // per single unit
  chargeableWeightKg Decimal  @db.Decimal(10, 3) // max(actual, volumetric) * quantity, this line's total
  createdAt          DateTime @default(now())

  @@index([orderId])
}

// Extra-protection add-on selected on the Payment page (transit warranty
// tier, heavy-duty cardboard, packing/wrapping service).
model OrderAddon {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  code      String // "WARRANTY" | "CARDBOARD" | "PACKING" | "WRAPPING"
  label     String
  quantity  Int      @default(1)
  unitPrice Decimal  @db.Decimal(10, 2)
  amount    Decimal  @db.Decimal(10, 2) // unitPrice * quantity
  createdAt DateTime @default(now())

  @@index([orderId])
}

model PromoCode {
  id             String    @id @default(uuid())
  code           String    @unique
  type           String // "PERCENT" | "FLAT"
  value          Decimal   @db.Decimal(10, 4)
  isActive       Boolean   @default(true)
  expiresAt      DateTime?
  maxRedemptions Int?
  timesRedeemed  Int       @default(0)
  createdAt      DateTime  @default(now())
}

// ------------------------------------------------------------
// Payments (Razorpay Orders — provider-agnostic schema)
// ------------------------------------------------------------
enum PaymentStatus {
  REQUIRES_PAYMENT
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
  CASH_PENDING // cash booking confirmed, amount to be collected at pickup
}

model Payment {
  id                String        @id @default(uuid())
  orderId           String        @unique
  order             Order         @relation(fields: [orderId], references: [id])
  provider          String        @default("razorpay")
  providerOrderId   String? // Razorpay Order id (order_xxx)
  providerPaymentId String? // Razorpay Payment id (pay_xxx), set once captured
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("INR")
  status            PaymentStatus @default(REQUIRES_PAYMENT)
  method            String? // "card" | "paypal" | ...
  rawWebhookPayload Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

// ------------------------------------------------------------
// Labels
// ------------------------------------------------------------
// One physical package's shipping label. A multi-item order (e.g. 3 boxes)
// gets one Label per package, each independently barcoded but linked back
// to the same order/tracking number.
model Label {
  id           String   @id @default(uuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id])
  packageIndex Int
  itemType     String
  fileUrl      String // path/URL to generated PDF
  barcodeValue String   @unique
  generatedAt  DateTime @default(now())

  @@index([orderId])
}

model Invoice {
  id          String   @id @default(uuid())
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id])
  fileUrl     String
  generatedAt DateTime @default(now())
}

// ------------------------------------------------------------
// Tracking
// ------------------------------------------------------------
model TrackingEvent {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  status     String
  location   String?
  note       String?
  occurredAt DateTime @default(now())
}

// ------------------------------------------------------------
// Audit log (admin actions)
// ------------------------------------------------------------
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())
}

// ------------------------------------------------------------
// Inventory (equipment/supplies used for courier services)
// ------------------------------------------------------------
model InventoryItem {
  id                String   @id @default(uuid())
  name              String   @unique // "Heavy-duty cardboard", "Wrap rolls"...
  unit              String   @default("pcs") // "boxes" | "rolls" | "pcs" ...
  quantity          Int      @default(0)
  lowStockThreshold Int?
  updatedById       String?
  updatedBy         User?    @relation(fields: [updatedById], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ------------------------------------------------------------
// Batch scan (staff/admin scan multiple shipping labels at once and
// bulk-update their order status)
// ------------------------------------------------------------
model ScanBatch {
  id          String          @id @default(uuid())
  name        String
  status      String
  createdById String
  createdBy   User            @relation(fields: [createdById], references: [id])
  items       ScanBatchItem[]
  createdAt   DateTime        @default(now())
}

model ScanBatchItem {
  id           String    @id @default(uuid())
  batchId      String
  batch        ScanBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  barcodeValue String
  orderId      String?
  orderNumber  String?
  matched      Boolean   @default(true) // false if the scanned barcode didn't resolve to a label
  createdAt    DateTime  @default(now())

  @@index([batchId])
}

// A physical location (warehouse bay, sorting hub, delivery vehicle...)
// with its own barcode. Scanning it during Batch Scan sets its label as the
// literal new Order.status on every matched order (e.g. "Sorted at hub"),
// and logs the same text as a comment with who scanned it and when.
model ScanLocation {
  id           String   @id @default(uuid())
  name         String // "Warehouse A - Inbound", "Van 3"...
  barcodeValue String   @unique
  label        String // also the literal status applied when scanned
  createdById  String
  createdBy    User     @relation(fields: [createdById], references: [id])
  createdAt    DateTime @default(now())
}
