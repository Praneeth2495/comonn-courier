# --- Server ---
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# --- Database (Postgres) ---
DATABASE_URL="postgresql://comonn_user:comonn_pass@localhost:5432/comonn_db?schema=public"

# --- Auth ---
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# --- Razorpay ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Email (Resend) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Comonn <quotes@comonn.in>
EMAIL_FROM_VERIFY=Comonn Verification <verify@comonn.in>
EMAIL_FROM_NOREPLY=Comonn <noreply@comonn.in>

# --- Labels ---
LABEL_STORAGE_DIR=./storage/labels
PUBLIC_LABEL_BASE_URL=http://localhost:4000/labels

# --- WhatsApp (Meta Cloud API) ---
# From your Meta Business Manager > WhatsApp Business Platform setup.
# Requires pre-approved message templates (see services/orderNotifications.js)
# before any status update can actually send.
WHATSAPP_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=xxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_API_VERSION=v20.0
# Webhook (WhatsApp Manager > Configuration > Webhook > Callback URL +
# Verify Token). WHATSAPP_VERIFY_TOKEN is any string you choose — pick one,
# put it here AND paste the same value into Meta's "Verify token" field.
# WHATSAPP_APP_SECRET is the App Secret from Meta App Dashboard > Settings >
# Basic (not the access token) — used to verify incoming webhook payloads
# are really from Meta. Optional but recommended; the endpoint still works
# without it, just without signature verification.
WHATSAPP_VERIFY_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Box Storage ---
# Shown to customers as "<this address>, Box <number>" once a rental is
# confirmed — set this to the real office address before going live.
BOX_STORAGE_ADDRESS="Comonn International Courier, <street address>, Hyderabad, Telangana <pincode>"
